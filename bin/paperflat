#!/usr/bin/env bash
#
# paperflat — replace every \input{} inside \begin{document}...\end{document}
#             with the actual content of that file, recursively. Nothing else.
#
#   paperflat [PROJECT_DIR] [options]
#
# The point is a single .tex holding all of the writing, for a journal or a
# language editor. The result is meant to be equivalent to the original, so by
# default this changes NOTHING else:
#
#   * comments are kept exactly as you wrote them
#   * a commented-out \input stays a comment and is NOT expanded
#   * the preamble is left alone (use --preamble to expand there too)
#   * \bibliography{} is left alone (use --bbl to inline the reference list)
#   * figures, spacing and blank lines are untouched
#
# THE SOURCE DIRECTORY IS NEVER MODIFIED. Everything happens in a copy.
#
# The result is then compiled and compared with your original PDF page by page,
# so you know before you send it that not one word moved.

set -uo pipefail

# --- find a TeX installation ------------------------------------------------
# Deliberately year- and architecture-agnostic: this must work with
# ~/texlive/<any year>/bin/<any platform>, MacTeX under /usr/local/texlive,
# /Library/TeX/texbin, a Linux distro package, Homebrew or MacPorts.
# Order: whatever is already on PATH wins; otherwise the path the installer
# recorded; otherwise the usual places.
_lt_conf="${XDG_CONFIG_HOME:-$HOME/.config}/latex-tools/config"
[ -r "$_lt_conf" ] && . "$_lt_conf"
if [ -n "${LATEX_TOOLS_TEXBIN:-}" ] && [ -x "${LATEX_TOOLS_TEXBIN}/pdflatex" ]; then
  case ":$PATH:" in *":${LATEX_TOOLS_TEXBIN}:"*) ;; *) PATH="$PATH:${LATEX_TOOLS_TEXBIN}" ;; esac
fi
if ! command -v pdflatex >/dev/null 2>&1; then
  for _d in "$HOME"/texlive/*/bin/* /usr/local/texlive/*/bin/* /opt/texlive/*/bin/* \
            /Library/TeX/texbin /opt/homebrew/bin /usr/local/bin /opt/local/bin; do
    [ -x "$_d/pdflatex" ] || continue
    case ":$PATH:" in *":$_d:"*) ;; *) PATH="$PATH:$_d" ;; esac
    break
  done
fi
export PATH

pick_python() {
  local p best=""
  for p in "${PAPERDIFF_PYTHON:-}" "$HOME/miniconda3/bin/python" /opt/miniconda3/bin/python \
           "$HOME/anaconda3/bin/python" /opt/anaconda3/bin/python \
           "$(command -v python3 2>/dev/null)" "$(command -v python 2>/dev/null)"; do
    [ -n "$p" ] && [ -x "$p" ] || continue
    "$p" -c 'import sys' >/dev/null 2>&1 || continue
    if "$p" -c 'import fitz' >/dev/null 2>&1; then echo "$p"; return 0; fi
    [ -z "$best" ] && best="$p"
  done
  [ -n "$best" ] && echo "$best"
}
PYTHON=$(pick_python)
[ -n "$PYTHON" ] || { echo "paperflat: no python found (needed to expand the file)" >&2; exit 1; }

SRC="$PWD"; OUT=""; MAIN=""
PREAMBLE=0; DOBBL=0; VERIFY=1
BUNDLE=0; FLATFIGS=0; DOZIP=0

usage() {
  cat <<'EOF'
paperflat — put all the writing of a nested LaTeX paper into ONE .tex file

USAGE
  paperflat [PROJECT_DIR] [options]        (PROJECT_DIR defaults to .)

  Every \input{} between \begin{document} and \end{document} is replaced by
  the contents of that file, recursively. Everything else is left exactly as
  it was: your comments, your spacing, your blank lines, the preamble and the
  \bibliography line. Output: <main>-flat.tex in the current directory.

OPTIONS
  -o PATH        output .tex file  (or output DIRECTORY with --bundle)
  -m FILE        main .tex file                    (default: auto-detect)
  --preamble     also expand \input{} in the preamble, so the file needs no
                 other .tex at all
  --bbl          also replace \bibliography{} with the reference list from the
                 .bbl, so the file needs no .bib either
  --no-verify    skip the compile-and-compare check (not recommended)

  --bundle       also copy the figures and local .sty/.cls the paper really
                 uses into the output directory
  --flat-figures with --bundle: all figures in one directory, paths rewritten
  --zip          with --bundle: also make submission.zip
  -h, --help     this message

EXAMPLES
  cd ~/Downloads/my_paper && paperflat
  paperflat ~/Downloads/my_paper -o ~/Desktop/aa62334-single.tex
  paperflat ~/Downloads/my_paper --preamble --bbl      # fully standalone
EOF
}

POS=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o) OUT="$2"; shift 2;;
    -m) MAIN="$2"; shift 2;;
    --preamble) PREAMBLE=1; shift;;
    --bbl) DOBBL=1; shift;;
    --no-verify) VERIFY=0; shift;;
    --bundle) BUNDLE=1; shift;;
    --flat-figures) FLATFIGS=1; BUNDLE=1; shift;;
    --zip) DOZIP=1; BUNDLE=1; shift;;
    -h|--help) usage; exit 0;;
    -*) echo "paperflat: unknown option '$1' (try --help)" >&2; exit 2;;
    *) POS="$1"; shift;;
  esac
done
[ -n "$POS" ] && SRC="$POS"
SRC=$(cd "$SRC" 2>/dev/null && pwd) || { echo "paperflat: cannot read '$POS'" >&2; exit 1; }

command -v latexmk  >/dev/null || { echo "paperflat: latexmk not found on PATH" >&2; exit 1; }
command -v pdflatex >/dev/null || { echo "paperflat: pdflatex not found on PATH" >&2; exit 1; }

# --- main .tex --------------------------------------------------------------
if [ -z "$MAIN" ]; then
  hits=""
  for f in "$SRC"/*.tex; do
    [ -f "$f" ] || continue
    grep -q '\\documentclass' "$f" 2>/dev/null || continue
    grep -q '\\begin{document}' "$f" 2>/dev/null && hits="$hits $(basename "$f")"
  done
  set -- $hits
  if [ $# -eq 1 ]; then MAIN="$1"
  else
    for b in main.tex paper.tex ms.tex manuscript.tex aanda.tex; do
      for f in $hits; do [ "$f" = "$b" ] && MAIN="$b"; done
    done
  fi
  [ -n "$MAIN" ] || { echo "paperflat: cannot tell which .tex is the main file." >&2
                      echo "Candidates:$hits" >&2
                      echo "Use:  paperflat -m <file.tex>" >&2; exit 1; }
fi
[ -f "$SRC/$MAIN" ] || { echo "paperflat: '$MAIN' not found in $SRC" >&2; exit 1; }
JOB="${MAIN%.tex}"

if [ "$BUNDLE" = "1" ]; then
  [ -n "$OUT" ] || OUT="$PWD/submission"
  mkdir -p "$OUT" || exit 1
  OUTDIR=$(cd "$OUT" && pwd); NAME="$JOB"
else
  [ -n "$OUT" ] || OUT="$PWD/$JOB-flat.tex"
  [ -d "$OUT" ] && OUT="$OUT/$JOB-flat.tex"
  mkdir -p "$(dirname "$OUT")" 2>/dev/null
  OUTDIR=$(cd "$(dirname "$OUT")" && pwd)
  NAME=$(basename "$OUT"); NAME="${NAME%.tex}"
fi
OUTTEX="$OUTDIR/$NAME.tex"

echo "paperflat"
echo "  source : $SRC"
echo "  main   : $MAIN"
echo "  output : $OUTTEX"
echo

W=$(mktemp -d 2>/dev/null || mktemp -d -t paperflat) || { echo "cannot make a temp dir" >&2; exit 1; }
trap 'rm -rf "$W"' EXIT INT TERM
if command -v rsync >/dev/null 2>&1; then rsync -a "$SRC/" "$W/"; else cp -R "$SRC/." "$W/"; fi

# --- 1. compile the original (reference PDF, and the .bbl/.fls if wanted) ----
echo "==> compiling the original, to compare against later"
( cd "$W" && latexmk -pdf -interaction=nonstopmode -recorder "$MAIN" > "$OUTDIR/$NAME.original-build.log" 2>&1 )
if [ ! -f "$W/$JOB.pdf" ]; then
  echo "    the ORIGINAL paper does not compile - fix that first:" >&2
  grep -E '^!' -A4 "$W/$JOB.log" 2>/dev/null | head -20 | sed 's/^/      /' >&2
  exit 1
fi
ORIGPAGES=$(grep -o "Output written on $JOB.pdf ([0-9]* page" "$W/$JOB.log" | grep -o '[0-9]*' | tail -1)
echo "    original: ${ORIGPAGES:-?} pages"

# --- 2. expand --------------------------------------------------------------
echo "==> replacing \\input{} with file contents"
"$PYTHON" - "$W" "$MAIN" "$OUTTEX" "$PREAMBLE" "$DOBBL" "$JOB" <<'PYFLAT'
import os, re, sys

root, main, outtex = sys.argv[1], sys.argv[2], sys.argv[3]
do_preamble, do_bbl, job = sys.argv[4] == "1", sys.argv[5] == "1", sys.argv[6]

# \input{...} or \input {...}; \include{...} likewise. Nothing else is touched.
INPUT_RE = re.compile(r'\\(input|include)\s*\{([^}]*)\}')

def uncommented_spans(line):
    """Yield (start, end) of the part of the line that is real LaTeX, i.e.
    everything before an unescaped %."""
    i = 0
    while i < len(line):
        if line[i] == '%' and (i == 0 or line[i-1] != '\\'):
            return (0, i)
        i += 1
    return (0, len(line))

def resolve(path):
    p = path.strip()
    for cand in (p, p + '.tex'):
        full = os.path.join(root, cand)
        if os.path.isfile(full):
            return full
    return None

stats = {'expanded': 0, 'missing': [], 'skipped_comment': 0}

def expand_text(text, depth=0):
    """Replace \\input{}/\\include{} with file contents, recursively.
    Only outside comments. Everything else is returned untouched."""
    if depth > 15:
        return text
    out = []
    for line in text.splitlines(keepends=True):
        nl = ''
        body = line
        if body.endswith('\n'):
            nl, body = '\n', body[:-1]
        s, e = uncommented_spans(body)
        code, comment = body[s:e], body[e:]
        if not INPUT_RE.search(code):
            if INPUT_RE.search(comment):
                stats['skipped_comment'] += 1
            out.append(line)
            continue
        pos, pieces = 0, []
        for m in INPUT_RE.finditer(code):
            before = code[pos:m.start()]
            # If the \input is alone on its line, drop the indentation instead
            # of gluing it onto the first line of the inserted file. That keeps
            # the inserted file byte-for-byte verbatim, which matters when a
            # human (or a language editor) reads the result.
            if pos == 0 and before.strip() == '':
                before = ''
            pieces.append(before)
            full = resolve(m.group(2))
            if full is None:
                stats['missing'].append(m.group(2))
                pieces.append(m.group(0))          # leave it alone
            else:
                sub = open(full, encoding='utf-8', errors='surrogateescape').read()
                sub = expand_text(sub, depth + 1)
                # \include implies a page break on both sides; \input does not.
                if m.group(1) == 'include':
                    sub = '\\clearpage\n' + sub + '\n\\clearpage'
                if not sub.endswith('\n'):
                    sub += '\n'
                pieces.append(sub)
                stats['expanded'] += 1
            pos = m.end()
        pieces.append(code[pos:])
        out.append(''.join(pieces) + comment + nl)
    return ''.join(out)

src = open(os.path.join(root, main), encoding='utf-8', errors='surrogateescape').read()

# Split preamble / body / tail on the real \begin{document} (not a commented one)
def find_uncommented(text, needle):
    for m in re.finditer(re.escape(needle), text):
        line_start = text.rfind('\n', 0, m.start()) + 1
        s, e = uncommented_spans(text[line_start:m.start()])
        if e == m.start() - line_start:
            return m
    return None

mb = find_uncommented(src, r'\begin{document}')
me = find_uncommented(src, r'\end{document}')
if mb is None:
    sys.stderr.write("paperflat: no \\begin{document} found\n"); sys.exit(1)
body_start = mb.end()
body_end = me.start() if me else len(src)

preamble, body, tail = src[:body_start], src[body_start:body_end], src[body_end:]

body = expand_text(body)
if do_preamble:
    preamble = expand_text(preamble)

if do_bbl:
    bbl = os.path.join(root, job + '.bbl')
    if os.path.isfile(bbl):
        content = open(bbl, encoding='utf-8', errors='surrogateescape').read()
        def repl(m):
            s, e = uncommented_spans(m.group(0))
            return content
        new, n = re.subn(r'\\bibliography\s*\{[^}]*\}', lambda m: content, body)
        if n:
            body = new
            print("    bibliography inlined (%d references)" % content.count('\\bibitem'))
    else:
        print("    --bbl asked for, but no %s.bbl exists" % job)

open(outtex, 'w', encoding='utf-8', errors='surrogateescape').write(preamble + body + tail)

print("    %d \\input/\\include expanded" % stats['expanded'])
if stats['skipped_comment']:
    print("    %d commented-out \\input left as comments (not expanded)" % stats['skipped_comment'])
if stats['missing']:
    print("    COULD NOT FIND, left untouched: %s" % ", ".join(sorted(set(stats['missing']))))
if not do_preamble:
    pre_in = len(INPUT_RE.findall(preamble))
    if pre_in:
        print("    %d \\input left in the PREAMBLE (use --preamble to expand those too)" % pre_in)
PYFLAT
[ -s "$OUTTEX" ] || { echo "    expansion produced nothing" >&2; exit 1; }
echo "    $NAME.tex: $(wc -l < "$OUTTEX" | tr -d ' ') lines, $(du -h "$OUTTEX" | cut -f1)"

# --- 3. optional bundle -----------------------------------------------------
if [ "$BUNDLE" = "1" ]; then
  echo "==> collecting the figures and style files actually used (from the .fls)"
  "$PYTHON" - "$W" "$OUTDIR" "$JOB" "$NAME" "$FLATFIGS" <<'PYGATHER'
import os, re, shutil, sys
work, out, job, name = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
flatfigs = sys.argv[5] == "1"
inputs = []
fls = os.path.join(work, job + ".fls")
if os.path.exists(fls):
    for line in open(fls, encoding="utf-8", errors="replace"):
        if line.startswith("INPUT "):
            inputs.append(line[6:].strip())
SKIP = {".aux",".log",".out",".fls",".fdb_latexmk",".blg",".toc",".lof",".lot",
        ".synctex",".gz",".nav",".snm",".vrb",".spl",".bcf",".xml",".pdf"}
rel = []
for p in inputs:
    if os.path.isabs(p): continue
    q = os.path.normpath(p)
    if q.startswith("..") or os.path.splitext(q)[1].lower() in SKIP: continue
    if os.path.exists(os.path.join(work, q)) and q not in rel: rel.append(q)
tex   = [p for p in rel if p.lower().endswith(".tex")]
style = [p for p in rel if os.path.splitext(p)[1].lower() in (".sty",".cls",".bst",".cfg",".clo",".def")]
figs  = [p for p in rel if p not in tex and p not in style]
man = ["PAPERFLAT MANIFEST", "="*64, "flattened file : %s.tex" % name,
       "", "%d .tex inlined:" % len(tex)] + ["    "+p for p in sorted(tex)]
man += ["", "%d style/class file(s):" % len(style)]
for p in style:
    shutil.copy2(os.path.join(work,p), os.path.join(out, os.path.basename(p)))
    man.append("    "+os.path.basename(p))
renames = {}
man += ["", "%d figure(s):" % len(figs)]
for p in sorted(figs):
    if flatfigs:
        stem, ext = os.path.splitext(p)
        base = re.sub(r"[/\\]", "_", stem) + ext
        renames[stem.lstrip("./")] = os.path.splitext(base)[0]
        dst = os.path.join(out, base); man.append("    %-56s <- %s" % (base, p))
    else:
        dst = os.path.join(out, p); os.makedirs(os.path.dirname(dst), exist_ok=True)
        man.append("    "+p)
    shutil.copy2(os.path.join(work,p), dst)
if flatfigs and renames:
    tf = os.path.join(out, name+".tex")
    s = open(tf, encoding="utf-8", errors="replace").read(); c=[0]
    def fix(m):
        k = os.path.splitext(m.group(2).strip())[0].lstrip("./")
        if k in renames: c[0]+=1; return m.group(1)+"{"+renames[k]+"}"
        return m.group(0)
    s = re.sub(r"(\\includegraphics\s*(?:\[[^\]]*\])?\s*)\{([^}]*)\}", fix, s)
    open(tf,"w",encoding="utf-8").write(s)
    man += ["", "%d \\includegraphics path(s) rewritten." % c[0]]
    print("    figures put in one directory, %d path(s) rewritten" % c[0])
open(os.path.join(out,"MANIFEST.txt"),"w").write("\n".join(man)+"\n")
print("    %d style file(s), %d figure(s)" % (len(style), len(figs)))
PYGATHER
fi

# --- 4. verify --------------------------------------------------------------
if [ "$VERIFY" = "1" ]; then
  echo "==> verifying: compiling the flattened file and comparing with the original"
  # In bundle mode the \includegraphics paths may point at renamed copies, so
  # compile inside the bundle. Otherwise compile inside the project copy, which
  # tests the flattened TEXT and nothing else.
  if [ "$BUNDLE" = "1" ]; then
    VD="$W/__verify__"; rm -rf "$VD"; mkdir -p "$VD"
    if command -v rsync >/dev/null 2>&1; then
      rsync -a --exclude '*.log' --exclude 'submission.zip' "$OUTDIR/" "$VD/"
    else
      cp -R "$OUTDIR/." "$VD/"; rm -f "$VD"/*.log "$VD/submission.zip" 2>/dev/null
    fi
  else
    VD="$W"
  fi
  cp "$OUTTEX" "$VD/__flat__.tex"
  ( cd "$VD" && latexmk -pdf -interaction=nonstopmode __flat__.tex > "$OUTDIR/$NAME.verify-build.log" 2>&1 )
  if [ ! -f "$VD/__flat__.pdf" ]; then
    echo "    THE FLATTENED FILE DID NOT COMPILE:" >&2
    grep -E '^!' -A4 "$VD/__flat__.log" 2>/dev/null | head -20 | sed 's/^/      /' >&2
    echo "    full log: $OUTDIR/$NAME.verify-build.log" >&2
    exit 1
  fi
  NEWPAGES=$(grep -o "Output written on __flat__.pdf ([0-9]* page" "$VD/__flat__.log" | grep -o '[0-9]*' | tail -1)
  echo "    flattened: ${NEWPAGES:-?} pages (original: ${ORIGPAGES:-?})"
  if "$PYTHON" -c 'import fitz' >/dev/null 2>&1; then
    "$PYTHON" - "$W/$JOB.pdf" "$VD/__flat__.pdf" <<'PYCMP'
import fitz, re, sys, difflib
a, b = fitz.open(sys.argv[1]), fitz.open(sys.argv[2])
norm = lambda d: [re.sub(r"\s+", " ", p.get_text()).strip() for p in d]
A, B = norm(a), norm(b)
if len(A) != len(B):
    print("    PAGE COUNT DIFFERS: %d -> %d" % (len(A), len(B))); sys.exit(1)
bad = [i for i, (x, y) in enumerate(zip(A, B)) if x != y]
if not bad:
    print("    all %d pages are textually IDENTICAL to the original" % len(A)); sys.exit(0)
print("    %d of %d page(s) differ:" % (len(bad), len(A)))
for i in bad[:3]:
    sm = difflib.SequenceMatcher(None, A[i], B[i])
    print("      page %d (similarity %.4f)" % (i+1, sm.ratio()))
    for op, i1, i2, j1, j2 in sm.get_opcodes():
        if op != "equal":
            print("        %-7s %r -> %r" % (op, A[i][i1:i2][:70], B[i][j1:j2][:70]))
sys.exit(1)
PYCMP
    [ $? -eq 0 ] || echo "    ^ look at these before sending it"
  else
    [ "${NEWPAGES:-x}" = "${ORIGPAGES:-y}" ] \
      && echo "    page count matches (install PyMuPDF for a word-level check)" \
      || echo "    PAGE COUNT DIFFERS - check before sending"
  fi
  cp "$VD/__flat__.pdf" "$OUTDIR/$NAME.pdf" 2>/dev/null
fi

if [ "$DOZIP" = "1" ] && [ "$BUNDLE" = "1" ]; then
  echo "==> zipping"
  ( cd "$OUTDIR" && rm -f submission.zip && zip -qr submission.zip . -x '*.log' 'submission.zip' 'MANIFEST.txt' )
  echo "    $OUTDIR/submission.zip ($(du -h "$OUTDIR/submission.zip" | cut -f1))"
fi

echo
echo "==> done"
echo "    single .tex : $OUTTEX"
[ -f "$OUTDIR/$NAME.pdf" ] && echo "    proof it works: $OUTDIR/$NAME.pdf"
[ "$BUNDLE" = "1" ] && echo "    what is included: $OUTDIR/MANIFEST.txt"
exit 0
